{
  "manifest_version": 3,
  "name": "VidSharp — 视频自适应锐化",
  "version": "0.1.0",
  "description": "用 WebGPU 对网页视频做 RCAS 自适应锐化，真人与动画内容通用，开销极低。",
  "minimum_chrome_version": "113",
  "permissions": ["storage", "activeTab", "scripting"],
  "action": {
    "default_title": "VidSharp",
    "default_popup": "src/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle",
      "js": ["src/content.js"],
      "css": ["src/content.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/enhance.wgsl",
        "src/easu.wgsl",
        "src/ravu.wgsl",
        "src/data/ravu-lut.js",
        "src/rcas.wgsl",
        "src/grain.wgsl",
        "src/badge.wgsl"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
